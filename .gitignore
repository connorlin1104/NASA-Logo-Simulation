# =====================================================================
# Unity 6 (URP) — https://github.com/github/gitignore/blob/main/Unity.gitignore
# =====================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the asset itself is ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS / Rider / MonoDevelop solution & project files (Unity regenerates these)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider (user-specific IDE settings)
/.idea/

# Visual Studio / VS Code
/.vs/
/.vscode/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash reporter
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# macOS
.DS_Store

# Python cache from the helper exporters in Assets/_Project/Data
__pycache__/
*.pyc
